---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
const { title = 'Белла Шамилевна Рыбка', description = 'Психология, исследования и авторство' } = Astro.props;
---
<!doctype html>
<html lang="ru">
<head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="description" content={description} /><title>{title}</title><slot name="head" /></head>
<body><Header /><main><slot /></main><Footer /></body>
</html>
