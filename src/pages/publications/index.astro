---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { publishedPublications } from '../../data/publications';
const formatNumber = (number: number) => String(number).padStart(3, '0');
---
<BaseLayout title="Публикации — Белла Шамилевна Рыбка" description="Архив публикаций Беллы Шамилевны Рыбки о психологии и исследованиях">
  <section class="archive-page" aria-labelledby="archive-title">
    <div class="archive-intro">
      <div class="archive-intro-text"><p class="archive-kicker">АРХИВ</p><h1 id="archive-title">ПУБЛИКАЦИИ</h1></div>
      <img class="archive-star" src="/assets/graphics/03-vector-distressed-star.svg" alt="" aria-hidden="true" width="549" height="214" />
    </div>
    {publishedPublications.length ? (
      <div class="archive-grid">
        {publishedPublications.map((post) => (
          <a class="archive-card" href={`/publications/${post.slug}/`} aria-label={`${formatNumber(post.archiveNumber)}. ${post.title}`}>
            <span class="archive-number">{formatNumber(post.archiveNumber)}.</span>
            <img class="archive-cover" src={post.image} width="270" height="203" loading="lazy" alt="" />
            <span class="archive-card-title">{post.title}</span>
          </a>
        ))}
      </div>
    ) : <p class="archive-empty">Публикаций пока нет</p>}
  </section>
</BaseLayout>
