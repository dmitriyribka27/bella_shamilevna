---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { publishedPublications } from '../../data/publications';
const formatNumber = (number: number) => String(number).padStart(3, '0');
---
<BaseLayout lang="en" title="Publications - Rybka Bella Shamilevna" description="Publications by Rybka Bella Shamilevna on psychology and research.">
  <section class="archive-page" aria-labelledby="archive-title">
    <div class="archive-intro">
      <div class="archive-intro-text"><p class="archive-kicker">ARCHIVE</p><h1 id="archive-title">PUBLICATIONS</h1></div>
      <img class="archive-star" src="/assets/graphics/03-vector-distressed-star.svg" alt="" aria-hidden="true" width="549" height="214" />
    </div>
    {publishedPublications.length ? (
      <>
        <div class="archive-grid" id="archive-list">
          {publishedPublications.map((post, index) => (
            <a
              class:list={['archive-card', { 'archive-card--initially-hidden': index >= 8 }]}
              data-archive-card
              href={`/en/publications/${post.slug}/`}
              aria-label={`${formatNumber(post.archiveNumber)}. ${post.title}`}
            >
              <span class="archive-number">{formatNumber(post.archiveNumber)}.</span>
              <img class="archive-cover" src={post.image} width="270" height="203" loading="lazy" alt="" />
              <span class="archive-card-title">{post.title}</span>
            </a>
          ))}
        </div>
        {publishedPublications.length > 8 && (
          <button type="button" class="archive-load-more" id="archive-load-more" aria-controls="archive-list">
            SHOW MORE
          </button>
        )}
      </>
    ) : <p class="archive-empty">No publications yet</p>}
  </section>
</BaseLayout>

<script>
  const button = document.querySelector<HTMLButtonElement>('#archive-load-more');
  const hiddenCards = Array.from(document.querySelectorAll<HTMLElement>('.archive-card--initially-hidden'));
  let revealed = 0;

  button?.addEventListener('click', () => {
    hiddenCards.slice(revealed, revealed + 8).forEach((card) => {
      card.classList.remove('archive-card--initially-hidden');
    });
    revealed += 8;
    if (revealed >= hiddenCards.length) button.hidden = true;
  });
</script>
