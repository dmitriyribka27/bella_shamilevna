---
import BaseLayout from '../../layouts/BaseLayout.astro';

// Temporary structured content. Replace with the approved CMS record later.
// Never publish unverified qualifications from the visual mockup.
const profile = {
  name: 'RYBKA BELLA SHAMILEVNA',
  subtitle: 'PSYCHOLOGY, EXISTENTIAL COUNSELLING, WRITING',
  paragraphs: [
    'Psychologist and researcher interested in interpersonal relationships, embodiment and emotional experience.',
    'I graduated from the Faculty of Psychology at Moscow State University and completed additional training in body-oriented and humanistic psychotherapy.',
    'I work with individual concerns, conduct research and publish analytical writing.'
  ],
  education: [
    {
      id: 'mgtu',
      institution: 'Maykop State Technological University',
      program: 'Computer Operator, Vocational Education',
      description: 'Diploma with Honours'
    },
    {
      id: 'kubsu',
      institution: 'Kuban State University',
      program: 'Educational Psychology · incomplete higher education.',
      description: 'My formal studies ended, but my intellectual commitment to psychology remains. I plan to continue my education abroad.'
    }
  ],
  additionalEducation: [
    {
      id: 'body',
      program: 'Body-Oriented Psychotherapy',
      description: '280 академических часов · Diploma with Honours'
    },
    {
      id: 'existential',
      program: 'Existential Psychology and Methods of Existential Counselling',
      description: '1056 академических часов · Diploma with Honours'
    }
  ]
};
---
<BaseLayout lang="en" title="About Me - Rybka Bella Shamilevna" description="About Rybka Bella Shamilevna: psychological interests, publications and education.">
  <section class="about-page" aria-labelledby="about-title">
    <div class="about-hero">
      <div class="about-title-block">
        <p class="about-kicker">ABOUT ME</p>
        <h1 id="about-title">ABOUT ME</h1>
      </div>
      <img class="about-cloud" src="/assets/graphics/halftone-cloud.svg" alt="" aria-hidden="true" width="952" height="321" />
    </div>
    <div class="about-information">
      <div class="about-photo-column">
        <img class="about-portrait" src="/assets/images/about-portrait.png" width="378" height="460" alt="Portrait of Rybka Bella Shamilevna" />
      </div>
      <section class="about-biography" aria-label="Biography">
        <h2>{profile.name}</h2>
        <p class="about-subtitle">{profile.subtitle}</p>
        <div class="about-paragraphs">
          {profile.paragraphs.map(paragraph => <p>{paragraph}</p>)}
        </div>
      </section>
      <section class="about-education" aria-label="Education">
        <h2>EDUCATION</h2>
        <div class="about-education-list">
          {profile.education.map(item => <div class="about-education-item">
            <p class="about-education-name">{item.institution}</p>
            
            <p>{item.program}</p>
            {item.description && <p>{item.description}</p>}
          </div>)}
        </div>
        <h2 class="about-extra-title">ДОПОЛНИТЕЛЬНОЕ EDUCATION</h2>
        <div class="about-education-list">
          {profile.additionalEducation.map(item => <div class="about-education-item">
            <p class="about-education-name">{item.program}</p>
            <p>{item.description}</p>
          </div>)}
        </div>
      </section>
    </div>
  </section>
</BaseLayout>
