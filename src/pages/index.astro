---
import BaseLayout from '../layouts/BaseLayout.astro';
import PublicationCard from '../components/PublicationCard.astro';
import { previewPublications } from '../data/publications';
---
<BaseLayout>
  <section class="hero" aria-labelledby="hero-title"><div class="hero-content"><h1 id="hero-title">РЫБКА БЕЛЛА<br />ШАМИЛЕВНА</h1><p>ПСИХОЛОГИЯ · ИССЛЕДОВАНИЯ · АВТОРСТВО</p></div><img class="hero-portrait" src="/assets/images/home-portrait.png" alt="Чёрно-белый портрет Беллы" /><img class="hero-graphic hero-graphic-a" src="/assets/graphics/Group.svg" alt="" /><img class="hero-graphic hero-graphic-b" src="/assets/graphics/Group-1.svg" alt="" /><img class="hero-graphic hero-graphic-c" src="/assets/graphics/Group-2.svg" alt="" /></section>
  <img class="wave" src="/assets/graphics/wave.png" alt="" />
  <section class="home-lower"><div class="home-about"><h2>ОБО МНЕ</h2><p>О психологии, человеческой природе и противоречиях, которые делают нас людьми. Здесь собраны мои исследования, публикации, профессиональные интересы и личные наблюдения.</p><a href="/about/">ПОДРОБНЕЕ</a></div><div class="home-publications"><div class="section-heading"><h2>ПУБЛИКАЦИИ</h2><a href="/publications/">СМОТРЕТЬ ВСЕ</a></div><div class="publication-grid">{previewPublications.map((p) => <PublicationCard {...p} />)}</div></div></section>
</BaseLayout>
