---
import BaseLayout from '../layouts/BaseLayout.astro';

// Temporary structured content. Replace with the approved CMS record later.
// Never publish unverified qualifications from the visual mockup.
const profile = {
  name: 'БЕЛЛА ШАМИЛЕВНА РЫБКА',
  subtitle: 'ПСИХОЛОГИЯ, ЭКЗИСТЕНЦИАЛЬНОЕ КОНСУЛЬТИРОВАНИЕ, АВТОРСТВО',
  paragraphs: [
    'Психолог, исследователь в области межличностных отношений, телесности и эмоционального опыта.',
    'Окончила факультет психологии МГУ, имею дополнительное образование в области телесно-ориентированной и гуманистической психотерапии.',
    'Работаю с индивидуальными запросами, провожу исследования и публикую аналитические материалы.'
  ],
  education: [
    {
      id: 'mgtu',
      institution: 'Майкопский государственный технологический университет',
      program: 'Оператор ЭВМ, СПО',
      description: 'Диплом с отличием'
    },
    {
      id: 'kubsu',
      institution: 'Кубанский государственный университет',
      program: 'Психология образования · незавершённое высшее.',
      description: 'Академический развод состоялся. Интеллектуальная верность психологии сохранилась. Продолжение образования — за рубежом.'
    }
  ],
  additionalEducation: [
    {
      id: 'body',
      program: 'Телесно-ориентированная психотерапия',
      description: '280 академических часов · Диплом с отличием'
    },
    {
      id: 'existential',
      program: 'Экзистенциальная психология и методы экзистенциального консультирования',
      description: '1056 академических часов · Диплом с отличием'
    }
  ]
};
---
<BaseLayout title="Обо мне - Белла Рыбка" description="О Белле Шамилевне Рыбке: психологические интересы, публикации и образование.">
  <section class="about-page" aria-labelledby="about-title">
    <div class="about-hero">
      <div class="about-title-block">
        <p class="about-kicker">ОБО МНЕ</p>
        <h1 id="about-title">ОБО МНЕ</h1>
      </div>
      <img class="about-cloud" src="/assets/graphics/halftone-cloud.svg" alt="" aria-hidden="true" width="952" height="321" />
    </div>
    <div class="about-information">
      <div class="about-photo-column">
        <img class="about-portrait" src="/assets/images/about-portrait.png" width="378" height="460" alt="Портрет Беллы Шамилевны Рыбки" />
      </div>
      <section class="about-biography" aria-label="Биография">
        <h2>{profile.name}</h2>
        <p class="about-subtitle">{profile.subtitle}</p>
        <div class="about-paragraphs">
          {profile.paragraphs.map(paragraph => <p>{paragraph}</p>)}
        </div>
      </section>
      <section class="about-education" aria-label="Образование">
        <h2>ОБРАЗОВАНИЕ</h2>
        <div class="about-education-list">
          {profile.education.map(item => <div class="about-education-item">
            <p class="about-education-name">{item.institution}</p>
            
            <p>{item.program}</p>
            {item.description && <p>{item.description}</p>}
          </div>)}
        </div>
        <h2 class="about-extra-title">ДОПОЛНИТЕЛЬНОЕ ОБРАЗОВАНИЕ</h2>
        <div class="about-education-list">
          {profile.additionalEducation.map(item => <div class="about-education-item">
            <p class="about-education-name">{item.program}</p>
            <p>{item.description}</p>
          </div>)}
        </div>
      </section>
    </div>
  </section>
</BaseLayout>
