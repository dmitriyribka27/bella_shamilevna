---
/** BELLA SITE — complete editorial essay, last homepage section (before footer). */
interface Props { variant:'desktop'|'mobile'; lang:'ru'|'en'|'fr' }
const {variant,lang}=Astro.props;
const paragraphs=[
  "Человек требует свободы с удивительным постоянством. Он готов рассуждать о независимости, отстаивать право на собственное мнение и даже вступать в конфликты ради возможности самостоятельно распоряжаться своей жизнью. Однако стоит предоставить ему эту возможность без привычных оговорок, как обнаруживается одно весьма неприятное обстоятельство: свобода предполагает ответственность. А ответственность, в отличие от свободы, никогда не пользовалась особенной популярностью.",
  "Жан-Поль Сартр называл дурной верой особую форму самообмана, при которой человек пытается скрыть от самого себя собственную свободу. В этой концепции меня занимает не столько философское определение, сколько поразительная изобретательность, с которой мы превращаем собственные решения в обстоятельства непреодолимой силы.",
  "Человек вообще обладает редким талантом превращать биографию в защитительную речь. В ней обязательно найдётся место неблагоприятным обстоятельствам, чужой несправедливости и нескольким трагическим совпадениям. Собственное участие в происходящем, как правило, упоминается значительно реже.",
  "Впрочем, свобода, существующая исключительно ради удовлетворения собственных желаний, представляется мне довольно примитивной конструкцией. Здесь мне интересна другая традиция — адыгская этика, исследованию которой посвятил свои работы Барасби Бгажноков. В её центре находится не только положение человека среди других, но и нравственные требования, которые он предъявляет самому себе.",
  "В культуре, к которой я принадлежу по происхождению, достоинство не исчерпывается личным представлением о собственной значимости. Оно обнаруживается в поступках, отношении к окружающим, способности отвечать за своё слово. И мне кажется весьма занятным, что современный человек порой требует безусловного уважения к собственной личности, не считая нужным предъявлять к ней сколько-нибудь серьёзные требования.",
  "Разумеется, культурная традиция тоже не освобождает от вопросов. Насколько наши убеждения действительно принадлежат нам? Где проходит граница между нравственным выбором и привычкой соответствовать ожиданиям? И можно ли считать себя свободным, если собственное достоинство приходится постоянно доказывать чужими глазами?",
  "Меня интересует именно эта тонкая граница. Между свободой и произволом, принадлежностью и подчинением, представлением о себе и тем человеком, которого обнаруживают наши поступки.",
  "Я не питаю иллюзий относительно собственной последовательности. Более того, подозреваю, что способность обнаруживать противоречия в других ещё никого не избавляла от необходимости разбираться со своими.",
  "Возможно, поэтому меня так занимает человеческая природа. Она редко бывает последовательной, почти никогда не укладывается в одну теорию и обладает совершенно неприличной способностью опровергать наши самые убедительные заключения.",
  "Я предпочитаю оставаться на стороне вопросов. Они, как правило, честнее ответов."
];
const left=[paragraphs[0],paragraphs[1],paragraphs[2],paragraphs[7],paragraphs[8]];
const right=[paragraphs[3],paragraphs[4],paragraphs[5],paragraphs[6],paragraphs[9]];
---
{lang==='ru'&&variant==='desktop'&&(
 <section class="hero-essay hero-essay--desktop" aria-label="Эссе о свободе и ответственности">
  <div class="hero-essay__composition">
   <div class="hero-essay__left">
    <span class="hero-essay__shape-left" aria-hidden="true"></span>
    {left.map((p,i)=><p class:list={{'hero-essay__lead':i===0}}>{p}</p>)}
   </div>
   <div class="hero-essay__right">
    <span class="hero-essay__shape-right" aria-hidden="true"></span>
    {right.map(p=><p>{p}</p>)}
   </div>
   <img class="hero-essay__portrait" src="/assets/hero-essay/bella-essay-portrait.webp" width="800" height="1199" alt="Белла в тёмном пиджаке, сидит и смотрит вверх" loading="lazy" decoding="async"/>
  </div>
 </section>
)}
{lang==='ru'&&variant==='mobile'&&(
 <section class="hero-essay-mobile" aria-label="Эссе о свободе и ответственности">
  <div class="hero-essay-mobile__inner">
   <img class="hero-essay-mobile__portrait" src="/assets/hero-essay/bella-essay-portrait.webp" width="800" height="1199" alt="Белла в тёмном пиджаке, сидит и смотрит вверх" loading="lazy" decoding="async"/>
   <div class="hero-essay-mobile__text">
    {paragraphs.map((p,i)=><p class:list={{'hero-essay-mobile__lead':i===0}}>{p}</p>)}
   </div>
  </div>
 </section>
)}