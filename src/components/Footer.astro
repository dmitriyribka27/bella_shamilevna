---
const { lang = 'ru' } = Astro.props;
const en = lang === 'en';
const fr = lang === 'fr';
const legalPrefix = lang === 'en' ? '/en' : lang === 'fr' ? '/fr' : '';
const contacts = [
  { label: 'Telegram', href: 'https://t.me/skot4os', svg: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M22 2 11 13"/><path d="m22 2-7 20-4-9-9-4Z"/></svg>' },
  { label: 'Instagram', href: 'https://www.instagram.com/cognitioverum/', svg: '<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2.3" y="2.3" width="19.4" height="19.4" rx="5.5"/><circle cx="12" cy="12" r="4.2"/><circle class="insta-dot" cx="17.7" cy="6.5" r="1"/></svg>' },
  { label: 'Написать письмо', href: 'mailto:x88tsar@gmail.com', svg: '<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2" y="4.5" width="20" height="15" rx="1.5"/><path d="m2.7 5.4 9.3 7.4 9.3-7.4"/></svg>' },
];
---
<footer class="site-footer">
  <div class="footer-top">
    <div class="footer-adyghe" lang="ady">Псэр ети напэр къащтэ.</div>
    <div class="footer-contacts">
      <strong>{fr ? 'CONTACTS' : en ? 'CONTACTS' : 'КОНТАКТЫ'}</strong>
      <div class="footer-socials">
        {contacts.map(({label,href,svg}) => <a href={href} target={href.startsWith('mailto:') ? undefined : '_blank'} rel={href.startsWith('mailto:') ? undefined : 'noopener noreferrer'} aria-label={label.startsWith('Написать') ? (fr ? 'Écrire un courriel' : en ? 'Compose email' : label) : label} set:html={svg} />)}
      </div>
    </div>
    <nav class="footer-policies" aria-label={fr ? "Documents juridiques" : en ? "Legal documents" : "Правовые документы"}>
      <a href={`${legalPrefix}/privacy-policy/`}>{fr ? 'Politique de confidentialité' : en ? 'Privacy Policy' : 'Политика конфиденциальности'}</a>
      <a href={`${legalPrefix}/personal-data-policy/`}>{fr ? 'Politique de traitement des données personnelles' : en ? 'Personal Data Processing Policy' : 'Политика обработки персональных данных'}</a>
    </nav>
  </div>
  <div class="footer-bottom"><span>© {lang === 'ru' ? 'Белла Шамилевна Рыбка' : 'Bella Shamilevna Rybka'}</span><span>{fr ? 'Tous droits réservés' : en ? 'All rights reserved' : 'Все права защищены'}</span></div>
</footer>
