---
/* Temporary contact links confirmed by the site owner; can be updated later. */
const contacts = {
  telegram: 'https://t.me/skot4os',
  instagram: 'https://www.instagram.com/cognitioverum/',
  email: 'mailto:x88tsar@gmail.com',
};
const { lang = 'ru' } = Astro.props;
const en = lang === 'en';
const fr = lang === 'fr';
const prefix = lang === 'ru' ? '' : `/${lang}`;
const currentPath = Astro.url.pathname;
const relativePath = currentPath.replace(/^\/(en|fr|ka)(?=\/|$)/, '') || '/';
const languageHref = (target: 'ru' | 'en' | 'fr') => target === 'ru' ? relativePath : `/${target}${relativePath.startsWith('/') ? relativePath : '/'+relativePath}`;

const ui = {
  ru: { home: 'ГЛАВНАЯ', publications: 'ПУБЛИКАЦИИ', about: 'ОБО МНЕ', navigation: 'Основная навигация', socials: 'Социальные сети и почта', email: 'Написать письмо', choose: 'Выбрать язык сайта' },
  en: { home: 'HOME', publications: 'PUBLICATIONS', about: 'ABOUT ME', navigation: 'Main navigation', socials: 'Social media and email', email: 'Compose email', choose: 'Choose site language' },
  fr: { home: 'ACCUEIL', publications: 'PUBLICATIONS', about: 'À PROPOS', navigation: 'Navigation principale', socials: 'Réseaux sociaux et courriel', email: 'Rédiger un courriel', choose: 'Choisir la langue du site' }
}[lang] ?? { home: 'ГЛАВНАЯ', publications: 'ПУБЛИКАЦИИ', about: 'ОБО МНЕ', navigation: 'Основная навигация', socials: 'Социальные сети и почта', email: 'Написать письмо', choose: 'Выбрать язык сайта' };
const icon = {
  telegram: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M22 2 11 13"/><path d="m22 2-7 20-4-9-9-4Z"/></svg>',
  instagram: '<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2.3" y="2.3" width="19.4" height="19.4" rx="5.5"/><circle cx="12" cy="12" r="4.2"/><circle class="insta-dot" cx="17.7" cy="6.5" r="1"/></svg>',
  email: '<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2" y="4.5" width="20" height="15" rx="1.5"/><path d="m2.7 5.4 9.3 7.4 9.3-7.4"/></svg>',
};
---
<header class="site-header site-header--nav-only">
  <nav aria-label={ui.navigation}>
    <a href={`${prefix}/`} aria-current={Astro.url.pathname.replace(/\/?$/, '/') === `${prefix}/` ? 'page' : undefined}>{ui.home}</a>
    <a href={`${prefix}/publications/`} aria-current={Astro.url.pathname.includes('/publications/') ? 'page' : undefined}>{ui.publications}</a>
    <a href={`${prefix}/about/`} aria-current={Astro.url.pathname.includes('/about/') ? 'page' : undefined}>{ui.about}</a>
  </nav>
  <div class="header-right">
    <div class="header-socials" aria-label={ui.socials}>
      {Object.entries(icon).map(([name, svg]) => contacts[name]
        ? <a href={contacts[name]} target={name === 'email' ? undefined : '_blank'} rel={name === 'email' ? undefined : 'noopener noreferrer'} aria-label={name === 'telegram' ? 'Telegram' : name === 'instagram' ? 'Instagram' : ui.email} set:html={svg} />
        : <span class="social-unlinked" title={en ? "Link will be added after confirmation" : "Ссылка будет добавлена после подтверждения контакта"} aria-label={name === 'telegram' ? (en ? 'Telegram — link not provided' : 'Telegram — ссылка пока не указана') : name === 'instagram' ? (en ? 'Instagram — link not provided' : 'Instagram — ссылка пока не указана') : (en ? 'Email — address not provided' : 'Почта — адрес пока не указан')} set:html={svg} />
      )}
    </div>
    <nav class="desktop-languages" aria-label={ui.choose}>
      <a href={languageHref('ru')} lang="ru" hreflang="ru" aria-current={lang === 'ru' ? 'page' : undefined}>RU</a>
      <a href={languageHref('en')} lang="en" hreflang="en" aria-current={en ? 'page' : undefined}>EN</a>
      <a href={languageHref('fr')} lang="fr" hreflang="fr" aria-current={fr ? 'page' : undefined}>FR</a>
    </nav>
  </div>
</header>
