---
/* Temporary contact links confirmed by the site owner; can be updated later. */
const contacts = {
  telegram: 'https://t.me/skot4os',
  instagram: 'https://www.instagram.com/cognitioverum/',
  email: 'https://mail.google.com/mail/?view=cm&fs=1&to=skot4os%40bk.ru',
};
const icon = {
  telegram: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M22 2 11 13"/><path d="m22 2-7 20-4-9-9-4Z"/></svg>',
  instagram: '<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2.3" y="2.3" width="19.4" height="19.4" rx="5.5"/><circle cx="12" cy="12" r="4.2"/><circle class="insta-dot" cx="17.7" cy="6.5" r="1"/></svg>',
  email: '<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2" y="4.5" width="20" height="15" rx="1.5"/><path d="m2.7 5.4 9.3 7.4 9.3-7.4"/></svg>',
};
---
<header class="site-header">
  <a class="brand" href="/">БЕЛЛА ШАМИЛЕВНА</a>
  <nav aria-label="Основная навигация">
    <a href="/">ГЛАВНАЯ</a>
    <a href="/publications/">ПУБЛИКАЦИИ</a>
    <a href="/about/">ОБО МНЕ</a>
  </nav>
  <div class="header-right">
    <div class="header-socials" aria-label="Социальные сети и почта">
      {Object.entries(icon).map(([name, svg]) => contacts[name]
        ? <a href={contacts[name]} target="_blank" rel="noopener noreferrer" aria-label={name === 'telegram' ? 'Telegram' : name === 'instagram' ? 'Instagram' : 'Написать письмо через Gmail'} set:html={svg} />
        : <span class="social-unlinked" title="Ссылка будет добавлена после подтверждения контакта" aria-label={name === 'telegram' ? 'Telegram — ссылка пока не указана' : name === 'instagram' ? 'Instagram — ссылка пока не указана' : 'Почта — адрес пока не указан'} set:html={svg} />
      )}
    </div>
    <div class="language-switcher" data-language-switcher>
      <button class="header-lang language-trigger" type="button" aria-haspopup="true" aria-expanded="false" aria-controls="language-menu" aria-label="Выбрать язык сайта">
        <span data-current-language>RU</span>
        <svg class="language-chevron" viewBox="0 0 12 12" aria-hidden="true"><path d="m2.5 4.5 3.5 3 3.5-3" /></svg>
      </button>
      <div class="language-menu" id="language-menu" hidden>
        <button class="language-option is-selected" type="button" data-language="ru" aria-pressed="true"><span>RU</span><span>Русский</span></button>
        <button class="language-option" type="button" data-language="en" aria-pressed="false"><span>EN</span><span>English</span></button>
        <p class="language-note" data-language-note hidden>English translation is coming soon. The site content is currently in Russian.</p>
      </div>
    </div>
  </div>
</header>

<script>
  const switcher = document.querySelector<HTMLElement>('[data-language-switcher]');
  if (switcher) {
    const trigger = switcher.querySelector<HTMLButtonElement>('.language-trigger')!;
    const menu = switcher.querySelector<HTMLElement>('.language-menu')!;
    const current = switcher.querySelector<HTMLElement>('[data-current-language]')!;
    const note = switcher.querySelector<HTMLElement>('[data-language-note]')!;
    const options = Array.from(switcher.querySelectorAll<HTMLButtonElement>('[data-language]'));
    const close = () => { menu.hidden = true; trigger.setAttribute('aria-expanded', 'false'); };
    const select = (language: string) => {
      current.textContent = language.toUpperCase();
      options.forEach((option) => {
        const selected = option.dataset.language === language;
        option.classList.toggle('is-selected', selected);
        option.setAttribute('aria-pressed', String(selected));
      });
      note.hidden = language !== 'en';
      // The page text stays Russian until translations are actually published.
      close();
    };
    trigger.addEventListener('click', () => {
      const opening = menu.hidden;
      menu.hidden = !opening;
      trigger.setAttribute('aria-expanded', String(opening));
    });
    options.forEach((option) => option.addEventListener('click', () => select(option.dataset.language || 'ru')));
    document.addEventListener('click', (event) => {
      if (!switcher.contains(event.target as Node)) close();
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') { close(); trigger.focus(); }
    });
  }
</script>
