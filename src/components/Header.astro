---
/* Temporary contact links confirmed by the site owner; can be updated later. */
const contacts = {
  telegram: 'https://t.me/skot4os',
  instagram: 'https://www.instagram.com/cognitioverum/',
  email: 'https://mail.google.com/mail/?view=cm&fs=1&to=skot4os%40bk.ru',
};
const { lang = 'ru' } = Astro.props;
const en = lang === 'en';
const fr = lang === 'fr';
const prefix = lang === 'ru' ? '' : `/${lang}`;
const ui = {
  ru: { home: 'ГЛАВНАЯ', publications: 'ПУБЛИКАЦИИ', about: 'ОБО МНЕ', navigation: 'Основная навигация', socials: 'Социальные сети и почта', email: 'Написать письмо через Gmail', choose: 'Выбрать язык сайта' },
  en: { home: 'HOME', publications: 'PUBLICATIONS', about: 'ABOUT ME', navigation: 'Main navigation', socials: 'Social media and email', email: 'Compose email in Gmail', choose: 'Choose site language' },
  fr: { home: 'ACCUEIL', publications: 'PUBLICATIONS', about: 'À PROPOS', navigation: 'Navigation principale', socials: 'Réseaux sociaux et courriel', email: 'Rédiger un courriel dans Gmail', choose: 'Choisir la langue du site' }
}[lang] ?? { home: 'ГЛАВНАЯ', publications: 'ПУБЛИКАЦИИ', about: 'ОБО МНЕ', navigation: 'Основная навигация', socials: 'Социальные сети и почта', email: 'Написать письмо через Gmail', choose: 'Выбрать язык сайта' };
const icon = {
  telegram: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M22 2 11 13"/><path d="m22 2-7 20-4-9-9-4Z"/></svg>',
  instagram: '<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2.3" y="2.3" width="19.4" height="19.4" rx="5.5"/><circle cx="12" cy="12" r="4.2"/><circle class="insta-dot" cx="17.7" cy="6.5" r="1"/></svg>',
  email: '<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2" y="4.5" width="20" height="15" rx="1.5"/><path d="m2.7 5.4 9.3 7.4 9.3-7.4"/></svg>',
};
---
<header class="site-header">
  <a class="brand" href={`${prefix}/`}>{lang === 'ru' ? 'БЕЛЛА ШАМИЛЕВНА' : 'BELLA SHAMILEVNA'}</a>
  <nav aria-label={ui.navigation}>
    <a href={`${prefix}/`}>{ui.home}</a>
    <a href={`${prefix}/publications/`}>{ui.publications}</a>
    <a href={`${prefix}/about/`}>{ui.about}</a>
  </nav>
  <div class="header-right">
    <div class="header-socials" aria-label={ui.socials}>
      {Object.entries(icon).map(([name, svg]) => contacts[name]
        ? <a href={contacts[name]} target="_blank" rel="noopener noreferrer" aria-label={name === 'telegram' ? 'Telegram' : name === 'instagram' ? 'Instagram' : ui.email} set:html={svg} />
        : <span class="social-unlinked" title={en ? "Link will be added after confirmation" : "Ссылка будет добавлена после подтверждения контакта"} aria-label={name === 'telegram' ? (en ? 'Telegram — link not provided' : 'Telegram — ссылка пока не указана') : name === 'instagram' ? (en ? 'Instagram — link not provided' : 'Instagram — ссылка пока не указана') : (en ? 'Email — address not provided' : 'Почта — адрес пока не указан')} set:html={svg} />
      )}
    </div>
    <div class="language-switcher" data-language-switcher>
      <button class="header-lang language-trigger" type="button" aria-haspopup="true" aria-expanded="false" aria-controls="language-menu" aria-label={ui.choose}>
        <span data-current-language>{lang.toUpperCase()}</span>
        <svg class="language-chevron" viewBox="0 0 12 12" aria-hidden="true"><path d="m2.5 4.5 3.5 3 3.5-3" /></svg>
      </button>
      <div class="language-menu" id="language-menu" hidden>
        <button class:list={['language-option', {'is-selected': lang === 'ru'}]} type="button" data-language="ru" aria-pressed={lang === 'ru'}><span>RU</span><span>Русский</span></button>
        <button class:list={['language-option', {'is-selected': en}]} type="button" data-language="en" aria-pressed={en}><span>EN</span><span>English</span></button>
        <button class:list={['language-option', {'is-selected': fr}]} type="button" data-language="fr" aria-pressed={fr}><span>FR</span><span>Français</span></button>
        </div>
    </div>
  </div>
</header>

<script>
  const switcher = document.querySelector<HTMLElement>('[data-language-switcher]');
  if (switcher) {
    const trigger = switcher.querySelector<HTMLButtonElement>('.language-trigger')!;
    const menu = switcher.querySelector<HTMLElement>('.language-menu')!;
    const options = Array.from(switcher.querySelectorAll<HTMLButtonElement>('[data-language]'));
    const close = () => { menu.hidden = true; trigger.setAttribute('aria-expanded', 'false'); };
    const routeFor = (language: string) => {
      const path = window.location.pathname;
      const base = path.replace(/^\/(en|fr)(?=\/)/, '');
      // Legal translations will be published from lawyer-approved documents separately.
      if (base.startsWith('/privacy-policy/') || base.startsWith('/personal-data-policy/')) return base;
      return language === 'ru' ? base : `/${language}${base}`;
    };
    trigger.addEventListener('click', () => {
      const opening = menu.hidden;
      menu.hidden = !opening;
      trigger.setAttribute('aria-expanded', String(opening));
    });
    options.forEach((option) => option.addEventListener('click', () => { const target = routeFor(option.dataset.language || 'ru'); if (target !== window.location.pathname) window.location.assign(target); else close(); }));
    document.addEventListener('click', (event) => {
      if (!switcher.contains(event.target as Node)) close();
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') { close(); trigger.focus(); }
    });
  }
</script>
