---
/* Contact URLs are intentionally unset until Bella confirms her accounts. */
const contacts = {
  telegram: '',
  instagram: '',
  email: '',
};
const icon = {
  telegram: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m21.3 3.7-3.2 16.1c-.2 1-1 1.2-1.8.7l-4.9-3.6-2.4 2.3c-.3.3-.5.5-1 .5l.4-5.1 9.3-8.4c.4-.4-.1-.6-.6-.3L5.6 13.2l-4.8-1.5c-1-.3-1-1 .2-1.5L19.8 3c.9-.3 1.7.2 1.5.7Z"/></svg>',
  instagram: '<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2.3" y="2.3" width="19.4" height="19.4" rx="5.5"/><circle cx="12" cy="12" r="4.2"/><circle class="insta-dot" cx="17.7" cy="6.5" r="1"/></svg>',
  email: '<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2" y="4.5" width="20" height="15" rx="1.5"/><path d="m2.7 5.4 9.3 7.4 9.3-7.4"/></svg>',
};
---
<header class="site-header">
  <a class="brand" href="/">БЕЛЛА ШАМИЛЕВНА</a>
  <nav aria-label="Основная навигация">
    <a href="/">ГЛАВНАЯ</a>
    <a href="/publications/">ПУБЛИКАЦИИ</a>
    <a href="/about/">ОБО МНЕ</a>
  </nav>
  <div class="header-right">
    <div class="header-socials" aria-label="Социальные сети и почта">
      {Object.entries(icon).map(([name, svg]) => contacts[name]
        ? <a href={name === 'email' ? `mailto:${contacts[name]}` : contacts[name]} target={name === 'email' ? undefined : '_blank'} rel={name === 'email' ? undefined : 'noopener noreferrer'} aria-label={name === 'telegram' ? 'Telegram' : name === 'instagram' ? 'Instagram' : 'Электронная почта'} set:html={svg} />
        : <span class="social-unlinked" title="Ссылка будет добавлена после подтверждения контакта" aria-label={name === 'telegram' ? 'Telegram — ссылка пока не указана' : name === 'instagram' ? 'Instagram — ссылка пока не указана' : 'Почта — адрес пока не указан'} set:html={svg} />
      )}
    </div>
    <span class="header-lang" lang="ru">RU</span>
  </div>
</header>
