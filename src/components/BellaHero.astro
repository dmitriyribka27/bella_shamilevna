---
interface Props { lang: 'ru' | 'en' | 'fr'; tagline: string; portraitAlt: string; soul: string; river: string }
const { lang, tagline, portraitAlt, soul, river } = Astro.props;
const first = lang === 'ru' ? 'БЕЛЛА' : 'BELLA';
const second = lang === 'ru' ? 'ШАМИЛЕВНА' : 'SHAMILEVNA';
const surname = lang === 'ru' ? 'РЫБКА' : 'RYBKA';
const pse = lang === 'ru' ? 'ПСЭ' : 'PSE';

// Sampled directly from V3 desktop river PNG's opaque stroke.
// cqw keeps the portrait mask aligned with the displayed width of that
// same PNG, even when the desktop layout is proportionally resized.
const riverBottomOffsets = [0.941,1.156,1.341,1.336,1.152,0.962,0.976,1.173,1.465,1.706,1.843,1.841,1.725,1.507,1.219,0.958,0.736,0.592,0.547,0.635,0.805,1.022,1.22,1.317,1.359,1.429,1.608,1.865,2.115,2.258,2.219,2.019,1.704,1.562,1.713,2.035,2.14,1.941,1.681,1.694,1.956,2.369,2.849,3.132,3.038,2.669,2.392,2.355,2.494,2.664,2.709,2.584,2.307,1.898,1.517,1.235,1.054,0.97,0.99,1.096,1.236,1.36,1.405,1.359,1.246,1.081,0.924,0.823,0.823,0.944,1.176,1.471,1.744,1.955,2.063,2.005,1.79,1.484,1.29,1.295,1.451];
const riverClip = 'polygon(0% 0%, 100% 0%, ' +
  riverBottomOffsets.slice().reverse().map((offset, reverseIndex) => {
    const x = ((riverBottomOffsets.length - 1 - reverseIndex) * 100 / (riverBottomOffsets.length - 1)).toFixed(3);
    return `${x}% calc(100% - ${offset}cqw)`;
  }).join(', ') + ')';
---
<section class="bella-hero" aria-labelledby="hero-title">
  <div class="bella-hero__stage">
    <img class="bella-hero__rays" src="/assets/home-redesign/rays-use-this-exact.svg"
      alt="" aria-hidden="true" width="775" height="742" decoding="async"/>
    <img class="bella-hero__mountains" src="/assets/home-redesign/mountains-light.png"
      alt="" aria-hidden="true" width="2180" height="721" decoding="async"/>
    <div class="bella-hero__heading">
      <h1 id="hero-title">
        <span>{first}</span>
        <span>{second}</span>
        <span class="bella-hero__surname">
          <span>{surname}</span><i aria-hidden="true"></i>
        </span>
      </h1>
      <p class="bella-hero__tagline">{tagline}</p>
    </div>
    <div class="bella-hero__portrait-layer" style={`clip-path:${riverClip};-webkit-clip-path:${riverClip}`}>
      <img class="bella-hero__portrait" src="/assets/images/home-portrait.png"
        width="338" height="507" alt={portraitAlt} fetchpriority="high" decoding="async"/>
    </div>
    <div class="bella-hero__side" aria-label={pse + ' — ' + soul}>
      <span>{pse}</span><i aria-hidden="true"></i><span>{soul}</span>
    </div>
    <div class="bella-hero__river" aria-hidden="true">
      <img src="/assets/home-redesign/river-desktop-v3.png"
        width="2172" height="78" alt="" decoding="async"/>
    </div>
    <span class="bella-hero__river-caption">{river}</span>
  </div>
</section>
