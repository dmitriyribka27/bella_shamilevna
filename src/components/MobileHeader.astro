---
import {sitePrefix,type SiteLanguage} from '../i18n/site';
interface Props {lang:SiteLanguage}
const {lang}=Astro.props;
const prefix=sitePrefix(lang);
const t={ru:{menu:'Меню',choose:'Выбор языка',home:'ГЛАВНАЯ',publications:'ПУБЛИКАЦИИ',about:'ОБО МНЕ'},en:{menu:'Menu',choose:'Choose language',home:'HOME',publications:'PUBLICATIONS',about:'ABOUT ME'},fr:{menu:'Menu',choose:'Choisir la langue',home:'ACCUEIL',publications:'PUBLICATIONS',about:'À PROPOS'}}[lang];
---
<header class="bm-mobile-header" data-bm-mobile-header>
 <div class="bm-mobile-header-line">
  <a class="bm-mobile-brand" href={`${prefix}/`}>{lang==='ru'?'БЕЛЛА ШАМИЛЕВНА':'BELLA SHAMILEVNA'}</a>
  <div class="bm-mobile-header-actions">
   <button class="bm-mobile-menu-trigger" type="button" aria-controls="bm-mobile-nav" aria-expanded="false" aria-label={t.menu} data-bm-open="nav"><span class="bm-mobile-hamburger" aria-hidden="true"><i></i><i></i><i></i></span></button>
   <button class="bm-mobile-language-trigger" type="button" aria-controls="bm-mobile-languages" aria-expanded="false" aria-label={t.choose} data-bm-open="languages">{lang.toUpperCase()}</button>
  </div>
 </div>
 <nav class="bm-mobile-popover bm-mobile-nav" id="bm-mobile-nav" aria-label={t.menu} hidden>
  <a href={`${prefix}/` } aria-current="page">{t.home}</a><a href={`${prefix}/publications/`}>{t.publications}</a><a href={`${prefix}/about/`}>{t.about}</a>
 </nav>
 <nav class="bm-mobile-popover bm-mobile-languages" id="bm-mobile-languages" aria-label={t.choose} hidden>
  <a href="/" aria-current={lang==='ru'?'page':undefined}><b>RU</b>Русский</a><a href="/en/" aria-current={lang==='en'?'page':undefined}><b>EN</b>English</a><a href="/fr/" aria-current={lang==='fr'?'page':undefined}><b>FR</b>Français</a>
 </nav>
</header>
<script>
 const h=document.querySelector<HTMLElement>('[data-bm-mobile-header]');
 if(h){
  const buttons=Array.from(h.querySelectorAll<HTMLButtonElement>('[data-bm-open]'));
  const getPanel=(b:HTMLButtonElement)=>h.querySelector<HTMLElement>('#bm-mobile-'+(b.dataset.bmOpen==='nav'?'nav':'languages'))!;
  const close=(focus=false)=>{const active=buttons.find(b=>b.getAttribute('aria-expanded')==='true');buttons.forEach(b=>{b.setAttribute('aria-expanded','false');getPanel(b).hidden=true});h.classList.remove('bm-nav-open');if(focus)active?.focus()};
  buttons.forEach(b=>b.addEventListener('click',()=>{const open=b.getAttribute('aria-expanded')!=='true';close();if(open){getPanel(b).hidden=false;b.setAttribute('aria-expanded','true');if(b.dataset.bmOpen==='nav')h.classList.add('bm-nav-open')}}));
  document.addEventListener('click',e=>{if(!h.contains(e.target as Node))close()});
  document.addEventListener('keydown',e=>{if(e.key==='Escape')close(true)});
  window.matchMedia('(min-width:701px)').addEventListener('change',e=>{if(e.matches)close()});
 }
</script>